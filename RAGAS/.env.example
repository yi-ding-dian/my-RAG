# RAGAS 评估系统 — 环境变量配置
# 复制此文件为 .env 并填写实际值（.env 已被 gitignore 忽略，不入库）
# 字段与 backend/config.py 的 Settings 完全一致

# Qwen LLM (OpenAI 兼容 API)
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=not-needed
LLM_MODEL=Qwen3.5-9B-GPTQ-4bit
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=8192

# Embedding 模型
EMBEDDING_BASE_URL=http://localhost:8300/v1
EMBEDDING_API_KEY=not-needed
EMBEDDING_MODEL=bge-m3

# Elasticsearch（可选，仅检索链路时需要）
ES_HOST=localhost
# 非标准端口：默认适配端口转发场景，标准 ES 为 9200
ES_PORT=1200
ES_USER=elastic
ES_PASSWORD=changeme
ES_USE_SSL=false
ES_INDEX_PATTERN=kb_*
