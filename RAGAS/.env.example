# RAGAS 评估系统 — 环境变量配置
# 复制此文件为 .env 并填写实际值

# Qwen LLM (OpenAI 兼容 API)
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=Qwen3.5-9B-GPTQ-4bit

# Embedding 模型
EMBEDDING_BASE_URL=http://localhost:8300/v1
EMBEDDING_API_KEY=sk-your-key-here
EMBEDDING_MODEL=bge-m3

# Elasticsearch（可选，仅检索链路时需要）
ES_HOST=localhost
ES_PORT=1200
ES_USER=elastic
ES_PASSWORD=changeme
