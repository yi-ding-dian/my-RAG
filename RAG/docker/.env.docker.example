# ================= my-RAG 生产部署配置（docker compose 专用）=================
# 用法:
#   cp docker/.env.docker.example docker/.env.docker
#   vi docker/.env.docker        # 填写真实口令
#   docker compose -f docker/docker-compose.yml up -d --build
#
# 只放「**配错就起不来**」的启动依赖 + 密钥：
#   - JWT_SECRET : 未配置/弱于 16 字符 → 拒绝启动（main.py 启动校验）
#   - MYSQL_*    : init_db 建表+种子，连不上 → 启动失败，且无 UI 入口改回
#   - DATA_DIR / CORS_ORIGINS : 部署环境相关
#
# 其余配置（LLM / Embedding / MinerU / DeepDoc / MinIO / 检索 / 切块 /
# 向量存储）一律在网页「系统配置」里由超管维护——它们配错只影响功能、
# 不影响服务启动，随时可从 UI 改回。分工依据见 ../docs/配置归属清单.md。
#
# 容器内访问宿主机服务不能用 127.0.0.1（那是容器自身）。两种写法：
#   ① 局域网 IP：服务监听 0.0.0.0 时容器网络可直达（推荐）
#   ② host.docker.internal：仅当服务只监听 127.0.0.1 时用
#      （compose 已配 extra_hosts: host.docker.internal:host-gateway）
#
# 注意：全新部署（data/ 为空、无 settings.json）时，系统会用本文件造一份
# "默认配置"档案，上述服务地址需进 UI 手工填一遍。
# ==========================================================================

# ---- 服务 ----
DATA_DIR=/app/data
# CORS 白名单（逗号分隔，如 https://your-domain）；留空=拒绝跨域。
# Docker 部署前端经 nginx 反代属**同源**、不受 CORS 约束，故留空即可。
# 切勿用 *（它允许任意站点跨域调用 API，而 compose 已将 8091 暴露到宿主机）
CORS_ORIGINS=

# ---- 认证（必填：未配置或弱于 16 字符将拒绝启动）----
# 生成强密钥: openssl rand -hex 32
JWT_SECRET=

# ---- 数据库（启动依赖；UI 已无此入口）----
# MySQL 为硬前置：登录/多租户必需，无它服务无法启动。**二选一**：
#   ① 已有外部 MySQL（集中部署在某台机器）→ 直接填它的地址与端口
#   ② 想在本机起库（单机/离线形态）→ 用仓库内 infra 一键启动：
#        docker compose -f docker/docker-compose.infra.yml up -d mysql
#      口令须与 infra.yml 的 MYSQL_PASSWORD 一致；infra 把它映射到宿主机
#      5455 端口，故容器内填 host.docker.internal
# 注意：容器内不能用 127.0.0.1（那是容器自身，不是宿主机）
MYSQL_HOST=host.docker.internal
MYSQL_PORT=5455
MYSQL_USER=ragflow
MYSQL_PASSWORD=
MYSQL_DATABASE=my_rag
# 连接串覆盖（非空则优先于上方字段）：离线测试用 sqlite+aiosqlite://，生产留空
MYSQL_URL=

# ---- 存储与评估（无 UI 入口，只能在此配置）----
# 存储后端: minio（对象存储）/ local（存本地 data/storage，离线/无 MinIO 环境用）。
# MinIO 连接参数（endpoint/密钥/桶）不在此文件——在网页「系统配置」里配
STORAGE_BACKEND=minio
# RAGAS 评估系统（独立部署，宿主机 8090）；留空=不启用评估对接。
# 该值在 ragas_client.py 中经 os.environ.get 读取，env_file 注入直接生效
RAGAS_BASE_URL=
