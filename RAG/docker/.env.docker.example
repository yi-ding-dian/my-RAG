# ================= my-RAG 生产部署配置（docker compose 专用） =================
# 用法:
#   cp docker/.env.docker.example docker/.env.docker
#   vi docker/.env.docker        # 填写真实口令 / 外部服务地址
#   docker compose -f docker/docker-compose.yml up -d --build
# 说明: 本文件经 compose 的 env_file 注入【容器环境变量】。
#       backend/config.py 中 pydantic-settings 读取优先级: 环境变量 > .env 文件，
#       因此容器内全部字段（LLM_*/EMBEDDING_*/MINERU_* 等）均可由此文件覆盖，
#       字段名与 config.py 的 Settings 完全一致，请勿自造新字段。
#       运行时仍可在网页「系统配置」页改配置档案（data/settings.json 持久化），
#       本文件仅作为出厂默认值。
# 提示: 外部依赖（MySQL / MinIO / LLM / Embedding / MinerU / Rerank）的获取方式
#       与可降级性见 docs/external-deps.md；可用 docker-compose.infra.yml
#       一键启动 MySQL + MinIO。

# ---- 服务 ----
HOST=0.0.0.0
PORT=8091
CORS_ORIGINS=*
# 数据目录（compose 已 bind 挂载 ../data:/app/data，容器内即 /app/data）
DATA_DIR=/app/data

# ---- LLM 对话模型（OpenAI 兼容，如 DeepSeek / vLLM / LM Studio）----
# 容器内访问宿主机服务的两种方式（任选其一）:
#   ① 局域网 IP: LLM 已监听 0.0.0.0，容器网络可直接访问（推荐，本文件默认）
#   ② host.docker.internal: 仅当 LLM 只监听 127.0.0.1 时使用
#      （compose 已配置 extra_hosts: host.docker.internal:host-gateway，无需改 compose）
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=
LLM_MODEL=qwen3.6-35b-a3b-apex-quality
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# ---- Embedding（bge-m3，OpenAI 兼容，vLLM，同样走局域网 IP）----
EMBEDDING_BASE_URL=http://127.0.0.1:8300/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_CHARS=8000
EMBEDDING_TIMEOUT=60

# ---- MinerU 文档解析（独立部署，服务名 mineru-api，容器网络直连局域网 IP）----
MINERU_API_URL=http://127.0.0.1:8001
MINERU_TIMEOUT=300

# ---- RAGAS 评估系统（运行于宿主机 8090，经 host-gateway 访问）----
# 注意: RAGAS_BASE_URL 在 ragas_client.py 中经 os.environ.get 读取，
#       容器环境变量（env_file 注入）可直接生效
RAGAS_BASE_URL=http://host.docker.internal:8090

# ---- 检索参数 ----
RETRIEVAL_TOP_K=5

# ---- 切块参数 ----
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ---- 会话 ----
CHAT_HISTORY_ROUNDS=8

# ---- 数据库（MySQL，多租户 users/departments/kbs 表；也可在网页「系统配置」
#      档案中覆盖，容器内此值仅作出厂默认。MYSQL_URL 留空=按下方字段组装
#      mysql+aiomysql://；测试离线可注入 sqlite+aiosqlite://）----
# MySQL 为硬前置：登录/多租户必需，无它服务无法启动。可用
# docker compose -f docker/docker-compose.infra.yml up -d mysql 一键启动。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=5455
MYSQL_USER=ragflow
MYSQL_PASSWORD=<your-password>
MYSQL_DATABASE=my_rag
MYSQL_URL=

# ---- 对象存储（MinIO，原始文档 + MinerU 解析图片；网页配置档案可覆盖）----
# 可用 docker compose -f docker/docker-compose.infra.yml up -d minio 一键启动；
# 无 MinIO 时可将 STORAGE_BACKEND 改为 local（存本地 data/storage）。
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=<your-access-key>
MINIO_SECRET_KEY=<your-secret-key>
MINIO_BUCKET=my-rag
MINIO_SECURE=false
MINIO_REGION=
# 存储后端: minio / local（local 存本地 data/storage，离线/无 MinIO 环境用）
STORAGE_BACKEND=minio

# ---- 认证（JWT 签名密钥，生产环境必须改为强随机值！）----
# 生成: openssl rand -hex 32（启动时强度校验 <16 字符将拒绝启动）
JWT_SECRET=<generate-with-openssl-rand-hex-32>
