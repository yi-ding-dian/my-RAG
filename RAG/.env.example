# ================= my-RAG 后端配置（全部可注入，Docker 化友好） =================
# 使用方法：cp .env.example .env 后按实际环境填写真实值。

# ---- 服务端口 ----
HOST=0.0.0.0
PORT=8091

# ---- LLM 对话模型（OpenAI 兼容，如 LM Studio / vLLM）----
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=
LLM_MODEL=qwen3.6-35b-a3b-apex-quality
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# ---- Embedding（bge-m3，OpenAI 兼容，vLLM）----
EMBEDDING_BASE_URL=http://127.0.0.1:8300/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_CHARS=8000
EMBEDDING_TIMEOUT=60

# ---- MinerU 文档解析（独立部署，服务名 mineru-api；解析引擎选"自动"时
#      不可用会自动降级 pypdf/python-docx 纯文本提取）----
MINERU_API_URL=http://127.0.0.1:8001
MINERU_TIMEOUT=300

# ---- DeepDoc 解析（RAGFlow API，默认本机 9380；通过网页「系统配置」档案可覆盖）----
DEEPDOC_BASE_URL=http://127.0.0.1:9380
DEEPDOC_EMAIL=
DEEPDOC_PASSWORD=
DEEPDOC_TIMEOUT=300
DEEPDOC_DATASET_PREFIX=myrag-tmp-

# ---- 检索参数 ----
RETRIEVAL_TOP_K=5

# ---- RAGAS 评估系统（检索质量评估，独立部署，端口 8090）----
# 本地开发：RAGAS 与后端同机时可用 http://localhost:8090；
# Docker 部署：容器内访问宿主机用 host.docker.internal（见 docker/.env.docker）
# RAGAS_BASE_URL=http://host.docker.internal:8090

# ---- 切块参数 ----
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ---- 会话 ----
CHAT_HISTORY_ROUNDS=8

# ---- CORS（生产可限制为具体前端地址，逗号分隔）----
CORS_ORIGINS=*

# ---- 数据库（MySQL，多租户 users/departments/kbs 三表）----
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=5455
# MYSQL_USER=ragflow
# MYSQL_PASSWORD=<your-password>
# MYSQL_DATABASE=my_rag
# 连接串覆盖（测试离线用 sqlite+aiosqlite://；留空走上方字段组装 mysql+aiomysql://）
# MYSQL_URL=

# ---- 对象存储（MinIO，上传文档 + 解析图片）----
# MINIO_ENDPOINT=127.0.0.1:9000
# MINIO_ACCESS_KEY=<your-access-key>
# MINIO_SECRET_KEY=<your-secret-key>
# MINIO_BUCKET=my-rag
# MINIO_SECURE=false
# MINIO_REGION=
# 存储后端: minio / local（local 存本地 data/uploads，离线测试用）
# STORAGE_BACKEND=minio

# ---- 认证（JWT 签名密钥，生产环境必须改为强随机值！）----
# 生成强密钥: openssl rand -hex 32（启动时强度校验 <16 字符将拒绝启动）
# JWT_SECRET=<generate-with-openssl-rand-hex-32>
